<Window x:Class="EMailMPC.Desktop.ComposeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compose email"
        Width="820"
        Height="700"
        MinWidth="620"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="FromText"
                   Margin="0,0,0,4"
                   FontSize="12"
                   Foreground="{StaticResource MutedBrush}" />

        <Grid Grid.Row="1" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="To" VerticalAlignment="Center" />
            <TextBox x:Name="RecipientsBox"
                     Grid.Column="1"
                     MaxLength="4096"
                     AutomationProperties.Name="Message recipients" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Subject" VerticalAlignment="Center" />
            <TextBox x:Name="SubjectBox"
                     Grid.Column="1"
                     MaxLength="998"
                     AutomationProperties.Name="Message subject" />
        </Grid>

        <TextBox x:Name="BodyBox"
                 Grid.Row="3"
                 Padding="8"
                 FontSize="14"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 MaxLength="1048576"
                 AutomationProperties.Name="Message body" />

        <DockPanel Grid.Row="4" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="CancelButton"
                        Margin="0,0,8,0"
                        Content="Cancel"
                        Click="CancelButton_Click" />
                <Button x:Name="SaveDraftButton"
                        Margin="0,0,8,0"
                        Content="Save draft"
                        Click="SaveDraftButton_Click" />
                <Button x:Name="SendButton"
                        Content="Send email"
                        IsDefault="True"
                        Click="SendButton_Click" />
            </StackPanel>
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</Window>

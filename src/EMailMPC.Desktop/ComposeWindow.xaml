<Window x:Class="EMailMPC.Desktop.ComposeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compose email"
        Width="820"
        Height="700"
        MinWidth="620"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid x:Name="ComposeSurface" Margin="{StaticResource SpacingGroup}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="FromText"
                   Margin="0,0,0,4"
                   FontSize="{StaticResource UiFontSizeSmall}"
                   Foreground="{StaticResource MutedBrush}" />

        <Grid Grid.Row="1" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="To" VerticalAlignment="Center" />
            <TextBox x:Name="RecipientsBox"
                     Grid.Column="1"
                     MaxLength="4096"
                     TextChanged="ComposeField_TextChanged"
                     AutomationProperties.Name="Message recipients" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Subject" VerticalAlignment="Center" />
            <TextBox x:Name="SubjectBox"
                     Grid.Column="1"
                     MaxLength="998"
                     TextChanged="ComposeField_TextChanged"
                     AutomationProperties.Name="Message subject" />
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0">
                <Button x:Name="AttachFilesButton"
                        Content="Attach files..."
                        Click="AttachFilesButton_Click" />
                <Button x:Name="RemoveAttachmentButton"
                        Margin="0,4,0,0"
                        Content="Remove selected"
                        IsEnabled="False"
                        Click="RemoveAttachmentButton_Click" />
            </StackPanel>
            <ListBox x:Name="AttachmentsList"
                     Grid.Column="1"
                     MaxHeight="76"
                     SelectionChanged="AttachmentsList_SelectionChanged"
                     AutomationProperties.Name="Files attached to this message">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayText}"
                                   TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <TextBox x:Name="BodyBox"
                 Grid.Row="4"
                 Padding="{StaticResource SpacingControl}"
                 FontSize="{StaticResource UiFontSizeBody}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 MaxLength="1048576"
                 TextChanged="ComposeField_TextChanged"
                 AutomationProperties.Name="Message body" />

        <DockPanel Grid.Row="5" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="CancelButton"
                        Margin="0,0,8,0"
                        Content="Cancel"
                        IsCancel="True"
                        Click="CancelButton_Click" />
                <Button x:Name="SaveDraftButton"
                        Margin="0,0,8,0"
                        Content="Save draft"
                        Click="SaveDraftButton_Click" />
                <Button x:Name="SendButton"
                        Content="Send email"
                        IsDefault="True"
                        Click="SendButton_Click" />
            </StackPanel>
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap"
                       Text="Draft changes save automatically after a short pause." />
        </DockPanel>
    </Grid>
</Window>

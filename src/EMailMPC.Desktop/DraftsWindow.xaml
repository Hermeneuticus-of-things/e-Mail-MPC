<Window x:Class="EMailMPC.Desktop.DraftsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Saved drafts"
        Width="760"
        Height="480"
        MinWidth="580"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <Grid x:Name="DraftsSurface" Margin="{StaticResource SpacingGroup}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,8">
            <TextBlock Text="Saved drafts"
                       FontSize="{StaticResource UiFontSizeBody}"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource InkBrush}" />
            <TextBlock x:Name="AccountText"
                       Margin="0,4,0,0"
                       FontSize="{StaticResource UiFontSizeSmall}"
                       Foreground="{StaticResource MutedBrush}" />
        </StackPanel>

        <DataGrid x:Name="DraftsGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0"
                  SelectionChanged="DraftsGrid_SelectionChanged"
                  MouseDoubleClick="DraftsGrid_MouseDoubleClick"
                  AutomationProperties.Name="Saved drafts list">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="*" />
                <DataGridTextColumn Header="To" Binding="{Binding Recipients}" Width="220" />
                <DataGridTextColumn Header="Saved" Binding="{Binding UpdatedText}" Width="160" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="DeleteButton"
                        Margin="0,0,8,0"
                        Content="Delete draft"
                        IsEnabled="False"
                        Click="DeleteButton_Click" />
                <Button x:Name="OpenButton"
                        Margin="0,0,8,0"
                        Content="Open draft"
                        IsEnabled="False"
                        IsDefault="True"
                        Click="OpenButton_Click" />
                <Button Content="Close"
                        IsCancel="True" />
            </StackPanel>
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</Window>

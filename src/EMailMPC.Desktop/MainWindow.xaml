<Window x:Class="EMailMPC.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="eMail MPC"
        Width="1100"
        Height="720"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8"
        Loaded="Window_Loaded">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Right"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right">
                <TextBlock Text="WINDOWS DESKTOP"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#536270"
                           HorizontalAlignment="Right" />
                <TextBlock Text="Local data encrypted"
                           FontSize="12"
                           Foreground="#26734D"
                           HorizontalAlignment="Right" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="eMail MPC"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Foreground="#17212B" />
                <TextBlock Margin="0,5,0,0"
                           Text="A private, dependable email client."
                           FontSize="14"
                           Foreground="#536270" />
            </StackPanel>
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="0,20,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="SyncButton"
                        Margin="8,0,0,0"
                        Padding="18,8"
                        Content="Sync mail"
                        IsEnabled="False"
                        Click="SyncButton_Click" />
                <Button x:Name="ComposeButton"
                        Margin="8,0,0,0"
                        Padding="18,8"
                        Content="Compose"
                        IsEnabled="False"
                        Click="ComposeButton_Click" />
                <Button x:Name="AddAccountButton"
                        Margin="8,0,0,0"
                        Padding="18,8"
                        Content="Add account"
                        Click="AddAccountButton_Click" />
            </StackPanel>
            <ComboBox x:Name="AccountCombo"
                      MinWidth="250"
                      MinHeight="38"
                      VerticalContentAlignment="Center"
                      DisplayMemberPath="Label"
                      AutomationProperties.Name="Filter by email account"
                      SelectionChanged="AccountCombo_SelectionChanged" />
        </DockPanel>

        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox"
                     MinHeight="42"
                     Padding="12,9"
                     VerticalContentAlignment="Center"
                     FontSize="15"
                     ToolTip="Search locally stored mail (supports from:, subject:, -term, &quot;phrases&quot;)"
                     AutomationProperties.Name="Search local mail"
                     PreviewKeyDown="SearchBox_PreviewKeyDown" />
            <ComboBox x:Name="SortCombo"
                      Grid.Column="1"
                      Margin="10,0,0,0"
                      MinWidth="130"
                      MinHeight="42"
                      VerticalContentAlignment="Center"
                      FontSize="13"
                      SelectionChanged="SortCombo_SelectionChanged"
                      AutomationProperties.Name="Search result sort order">
                <ComboBoxItem Content="Newest first" IsSelected="True" />
                <ComboBoxItem Content="Relevance" />
            </ComboBox>
            <Button x:Name="SearchButton"
                    Grid.Column="2"
                    Margin="10,0,0,0"
                    Padding="22,8"
                    Content="Search"
                    FontSize="14"
                    IsDefault="True"
                    Click="SearchButton_Click" />
        </Grid>

        <DockPanel x:Name="QueryPlanPanel"
                   Grid.Row="3"
                   Margin="0,0,0,10"
                   Visibility="Collapsed">
            <TextBlock DockPanel.Dock="Left"
                       Margin="0,0,10,0"
                       VerticalAlignment="Center"
                       FontSize="13"
                       Foreground="#5A6B7B"
                       Text="Interpreted query (editable) :" />
            <TextBox x:Name="QueryPlanBox"
                     MinHeight="34"
                     Padding="10,7"
                     VerticalContentAlignment="Center"
                     FontSize="13"
                     Background="#F4F7FA"
                     ToolTip="The natural-language query interpreted into search operators. Edit and press Enter to refine."
                     AutomationProperties.Name="Interpreted query plan"
                     PreviewKeyDown="QueryPlanBox_PreviewKeyDown" />
        </DockPanel>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DataGrid x:Name="ResultsGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserResizeRows="False"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      Background="White"
                      BorderBrush="#DCE2E7"
                      BorderThickness="1"
                      RowHeaderWidth="0"
                      FontSize="13"
                      SelectionChanged="ResultsGrid_SelectionChanged"
                      AutomationProperties.Name="Local mail search results">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="From" Binding="{Binding Sender}" Width="220" />
                    <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="*" />
                    <DataGridTextColumn Header="Received" Binding="{Binding ReceivedAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="160" />
                    <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="130" />
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Row="1"
                    Margin="0,10,0,0"
                    Padding="14"
                    Background="White"
                    BorderBrush="#DCE2E7"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="MessageSubjectText"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Text="Select a message to read"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MessageMetadataText"
                               Grid.Row="1"
                               Margin="0,4,0,8"
                               FontSize="12"
                               Foreground="#697783"
                               TextTrimming="CharacterEllipsis" />
                    <TextBox x:Name="MessageBodyText"
                             Grid.Row="2"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             BorderThickness="0"
                             Background="Transparent"
                             AutomationProperties.Name="Selected message body" />
                </Grid>
            </Border>
        </Grid>

        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock x:Name="AccountCountText"
                       DockPanel.Dock="Right"
                       Text="No accounts connected"
                       FontSize="12"
                       Foreground="#697783" />
            <TextBlock x:Name="StatusText"
                       Text="Local search is ready."
                       FontSize="12"
                       Foreground="#536270" />
        </DockPanel>
    </Grid>
</Window>

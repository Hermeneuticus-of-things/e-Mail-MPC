<Window x:Class="EMailMPC.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="eMail MPC"
        Width="1320"
        Height="820"
        MinWidth="920"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0"
              Margin="0,0,0,4"
              Background="{StaticResource PaperBrush}"
              Foreground="{StaticResource InkBrush}"
              AutomationProperties.Name="Application menu">
            <MenuItem Header="_File">
                <MenuItem Header="_New message"
                          InputGestureText="Ctrl+N"
                          Click="ComposeButton_Click" />
                <Separator />
                <MenuItem x:Name="MenuAddAccountItem"
                          Header="_Add account..."
                          Click="AddAccountButton_Click" />
                <MenuItem x:Name="MenuRemoveAccountItem"
                          Header="_Remove selected account..."
                          IsEnabled="False"
                          Click="RemoveAccountButton_Click" />
                <Separator />
                <MenuItem Header="E_xit"
                          Click="ExitMenuItem_Click" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Find in local mail"
                          InputGestureText="Ctrl+F"
                          Click="FocusSearchMenuItem_Click" />
                <MenuItem Header="_Clear search"
                          Click="ClearSearchMenuItem_Click" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem x:Name="FoldersMenuItem"
                          Header="Mail _folders"
                          IsCheckable="True"
                          IsChecked="True"
                          Click="FoldersMenuItem_Click" />
                <MenuItem x:Name="ReaderMenuItem"
                          Header="Message _reader"
                          IsCheckable="True"
                          IsChecked="True"
                          Click="ReaderMenuItem_Click" />
            </MenuItem>
            <MenuItem Header="_Mail">
                <MenuItem Header="_Compose"
                          InputGestureText="Ctrl+N"
                          Click="ComposeButton_Click" />
                <Separator />
                <MenuItem x:Name="MenuSyncItem"
                          Header="_Sync selected account"
                          InputGestureText="Ctrl+R"
                          IsEnabled="False"
                          Click="SyncButton_Click" />
                <MenuItem x:Name="MenuDraftsItem"
                          Header="Saved _drafts..."
                          IsEnabled="False"
                          Click="DraftsButton_Click" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="Sort by _newest"
                          Click="SortNewestMenuItem_Click" />
                <MenuItem Header="Sort by _relevance"
                          Click="SortRelevanceMenuItem_Click" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About eMail MPC"
                          Click="AboutMenuItem_Click" />
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="AccountCombo"
                      Grid.Column="0"
                      Width="240"
                      VerticalContentAlignment="Center"
                      DisplayMemberPath="Label"
                      AutomationProperties.Name="Filter by email account"
                      SelectionChanged="AccountCombo_SelectionChanged" />
            <TextBox x:Name="SearchBox"
                     Grid.Column="1"
                     Margin="8,0,0,0"
                     VerticalContentAlignment="Center"
                     ToolTip="Search local mail with from:, subject:, in:, -term, or quoted phrases."
                     AutomationProperties.Name="Search local mail"
                     PreviewKeyDown="SearchBox_PreviewKeyDown" />
            <ComboBox x:Name="SortCombo"
                      Grid.Column="2"
                      Margin="8,0,0,0"
                      MinWidth="116"
                      VerticalContentAlignment="Center"
                      SelectionChanged="SortCombo_SelectionChanged"
                      AutomationProperties.Name="Search result sort order">
                <ComboBoxItem Content="Newest first" IsSelected="True" />
                <ComboBoxItem Content="Relevance" />
            </ComboBox>
            <Button x:Name="SearchButton"
                    Grid.Column="3"
                    Margin="8,0,0,0"
                    Content="Search"
                    IsDefault="True"
                    Click="SearchButton_Click" />
        </Grid>

        <DockPanel x:Name="QueryPlanPanel"
                   Grid.Row="2"
                   Margin="0,0,0,6"
                   Visibility="Collapsed">
            <TextBlock DockPanel.Dock="Left"
                       Margin="0,0,10,0"
                       VerticalAlignment="Center"
                       FontSize="13"
                       Foreground="{StaticResource MutedBrush}"
                       Text="Search plan" />
            <TextBox x:Name="QueryPlanBox"
                     VerticalContentAlignment="Center"
                     ToolTip="The interpreted search query. Edit it and press Enter to refine."
                     AutomationProperties.Name="Interpreted query plan"
                     PreviewKeyDown="QueryPlanBox_PreviewKeyDown" />
        </DockPanel>

        <Grid x:Name="MailWorkspaceGrid" Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FolderColumn" Width="168" />
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition x:Name="ReaderSplitterColumn" Width="4" />
                <ColumnDefinition x:Name="ReaderColumn" Width="1.15*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Margin="6,3,0,6"
                           Text="Mail folders"
                           FontSize="12"
                           FontWeight="SemiBold" />
                <ListBox x:Name="FolderListBox"
                         DisplayMemberPath="Label"
                         SelectionChanged="FolderListBox_SelectionChanged"
                         AutomationProperties.Name="Mail folders" />
            </StackPanel>

            <Grid Grid.Column="1">
                <DataGrid x:Name="ResultsGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          SelectionChanged="ResultsGrid_SelectionChanged"
                          AutomationProperties.Name="Local mail search results">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="From" Binding="{Binding Sender}" Width="150" />
                        <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="*" />
                        <DataGridTextColumn Header="Received" Binding="{Binding ReceivedAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="128" />
                        <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="88" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="EmptyResultsText"
                           Margin="20"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Text="No messages match this search."
                           Foreground="{StaticResource MutedBrush}"
                           IsHitTestVisible="False"
                           Visibility="Collapsed" />
            </Grid>

            <GridSplitter Grid.Column="2"
                          Width="4"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="{StaticResource RuleBrush}"
                          ShowsPreview="True"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          AutomationProperties.Name="Resize message list and reader" />

            <Border Grid.Column="3"
                    Margin="8,0,0,0"
                    Padding="14,10"
                    Background="{StaticResource PaperBrush}"
                    BorderBrush="{StaticResource RuleBrush}"
                    BorderThickness="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="120" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="MessageSubjectText"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Text="Select a message to read"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MessageMetadataText"
                               Grid.Row="1"
                               Margin="0,4,0,8"
                               FontSize="11"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" />
                    <TextBox x:Name="MessageBodyText"
                             Grid.Row="2"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             BorderThickness="0"
                             Background="Transparent"
                             AutomationProperties.Name="Selected message body" />
                    <DataGrid x:Name="AttachmentsGrid"
                              Grid.Row="3"
                              Margin="0,6,0,0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              AutomationProperties.Name="Selected message attachments">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Attachment"
                                                Binding="{Binding FileName}"
                                                Width="*" />
                            <DataGridTextColumn Header="Size"
                                                Binding="{Binding SizeText}"
                                                Width="58" />
                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding StatusText}"
                                                Width="88" />
                            <DataGridTemplateColumn Header="Action" Width="88">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding ActionText}"
                                                Tag="{Binding}"
                                                Padding="4,2"
                                                Click="SaveAttachmentButton_Click"
                                                IsEnabled="{Binding CanSave}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <DockPanel Grid.Row="4"
                   Margin="0,6,0,0"
                   LastChildFill="True">
            <TextBlock x:Name="AccountCountText"
                       DockPanel.Dock="Right"
                       Margin="8,0,0,0"
                       FontSize="11"
                       Foreground="{StaticResource MutedBrush}"
                       Text="No accounts connected" />
            <TextBlock x:Name="StatusText"
                       FontSize="11"
                       Foreground="{StaticResource MutedBrush}"
                       Text="Local search is ready." />
        </DockPanel>
    </Grid>
</Window>
